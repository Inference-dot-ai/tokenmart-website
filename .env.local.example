# Canonical origin for the site. Drives <link rel="canonical">, og:url,
# sitemap.xml and robots.txt. No trailing slash.
# Must match the domain actually served, or Google treats this site as a
# duplicate of whatever origin is declared here and drops it from the index.
NEXT_PUBLIC_SITE_URL=https://thetokenmart.com

# Model catalog (home page, /models, /api/catalog)
# Prices, list prices and discounts all come from drr400000's public endpoint.
# Set these in BOTH the build environment and the Cloudflare Pages Function env.
#
# TM_MODELS_ENDPOINT      Optional override, e.g. the staging gateway.
# TM_DISPLAY_MARKUP_PCT   Interim display markup (percent) on top of the endpoint
#                         price, capped at provider list price. Leave empty/0 once
#                         drr400000 serves a dedicated public tier.
TM_MODELS_ENDPOINT=
TM_DISPLAY_MARKUP_PCT=

# Volume pricing call to action (savings calculator)
# NEXT_PUBLIC_CONTACT_URL defaults to /signup when unset.
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_VOLUME_THRESHOLD_USD=5000

# Sign-up page Google Form. When unset, /signup sends people to the console.
NEXT_PUBLIC_GOOGLE_FORM_URL=

# Google service account, used only by functions/api/subscribe.ts.
#   1. https://console.cloud.google.com/ -> enable Google Sheets API
#   2. IAM -> Service Accounts -> create -> download JSON key
#   3. "client_email" -> GOOGLE_SERVICE_ACCOUNT_EMAIL, "private_key" -> GOOGLE_PRIVATE_KEY
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# Email capture sheet for the discount popup (/api/subscribe)
# Share this sheet with the service account above as EDITOR.
# Columns appended: A=ISO timestamp, B=email
# GOOGLE_SUBSCRIBE_SHEET_ID can be omitted to reuse GOOGLE_SHEET_ID above.
# GOOGLE_SUBSCRIBE_RANGE defaults to "Sheet1!A:B" — set it to match your tab name.
GOOGLE_SUBSCRIBE_SHEET_ID=1slYDZjwuJHflvgRSPFVcOmkTZM6KQ6J8snK6cbRuvho
GOOGLE_SUBSCRIBE_RANGE=Sheet1!A:B

# Getu Attribution — client (exposed to browser bundle, safe to publish)
# Without NEXT_PUBLIC_GETU_API_KEY the SDK init is a no-op and CTAs behave
# exactly as today. Removing this var is the rollback switch.
NEXT_PUBLIC_GETU_API_KEY=
# Optional: ".service-inference.ai" if marketing site shares root with console.
NEXT_PUBLIC_GETU_COOKIE_DOMAIN=
NEXT_PUBLIC_GETU_DEBUG=false

# Getu Attribution — server (Cloudflare Pages env, NEVER prefix NEXT_PUBLIC_).
# Used by functions/api/getu/scan.ts to proxy the Open API with HMAC signing.
# Caller must pass `X-Internal-Key: <GETU_API_KEY>` to authorize.
GETU_API_KEY=
GETU_API_SECRET=
